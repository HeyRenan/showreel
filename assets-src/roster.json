      "name": "showcase",
      "group": "hero",
      "tool": "rec",
      "page": "console-gate",
      "stepsFile": "showcase-steps.json",
      "args": [
        "--width",
        "1280",
        "--no-safeguards"
      ],
      "out": "assets/showcase.mp4",
      "heavy": true
    },
